# AUREONÉ Configuration Environment Template
# Copy this file to .env and configure your production secrets

PORT=3000
NODE_ENV=production

# Admin Credentials (Set a strong password for initial seed/override)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Cryptographic Session & Token Secret (64+ character random hex string)
SESSION_SECRET=aureone_production_secure_token_secret_replace_with_random_hex

# Allowed CORS Origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
